{
  "schema_version": "0.1",
  "agent_id": "lp-collector-agent",
  "purpose": "Run the fixed Palleta VK pilot in strict read-only mode",
  "working_directory": "local-point-vk-collector",
  "allowed_commands": [
    {
      "command": "powershell",
      "args_exact": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        ".\\agent\\Run-PalletaPilot.ps1"
      ]
    }
  ],
  "allowed_read_paths": [
    "local-point-vk-collector/**",
    "%LOCALAPPDATA%\\LocalPoint\\vk-evidence\\**"
  ],
  "allowed_write_paths": [
    "%LOCALAPPDATA%\\LocalPoint\\vk-profile\\**",
    "%LOCALAPPDATA%\\LocalPoint\\vk-evidence\\**"
  ],
  "forbidden_capabilities": [
    "arbitrary_shell",
    "arbitrary_node",
    "arbitrary_browser",
    "vk_write",
    "vk_messages",
    "credential_read",
    "credential_export",
    "captcha_bypass",
    "policy_relaxation",
    "git_write",
    "git_merge",
    "deploy"
  ],
  "human_login_may_be_requested_by_fixed_runner": true,
  "stop_on_blocked": true,
  "background_retry": false
}
